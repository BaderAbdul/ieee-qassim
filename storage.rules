rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Certificates are securely generated by the backend and only accessible via signed URLs
    match /certificates/{eventId}/{certificateId} {
      // Direct client reads are blocked to enforce the signed URL architecture
      // The backend gets download URLs and signs them.
      allow read, write: if false; 
    }
  }
}
