rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
    
    // Certificates are securely generated by the backend and only accessible via signed URLs
    match /certificates/{eventId}/{certificateId} {
      // Direct client reads are blocked to enforce the signed URL architecture
      // The backend gets download URLs and signs them.
      allow read, write: if false; 
    }
  }
}
