# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.spark-test/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Firebase service account keys (NEVER commit these)
*-adminsdk-*.json
service-account*.json

# Firebase debug logs
firebase-debug.log
firestore-debug.log
storage-debug.log
ui-debug.log
emulator.log

# Temporary/development files
firestore.rules.orig
firestore_temp_nevermind.txt
fix-imports.js
fix_rules.patch
