rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }
    
    function isEventOrganizer() {
      return isAuthenticated() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'event_organizer' || isSuperAdmin());
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      // Anyone can read their own profile, admins can read all
      allow read: if isOwner(userId) || isEventOrganizer();
      // Users can create/update their own profile (basic info), but cannot change their role or points directly
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'totalPoints']) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
    
    // Events Collection
    match /events/{eventId} {
      // Anyone can read published events
      allow read: if resource.data.state != 'Draft' || isEventOrganizer();
      // Only organizers can manage events
      allow write: if isEventOrganizer();
    }
    
    // Registrations Collection (Top-level)
    match /registrations/{registrationId} {
      allow read: if isOwner(resource.data.userId) || isEventOrganizer();
      // Client cannot create registrations directly; must use backend Callable Function
      allow create: if false; 
      // Users can only cancel their own registrations, admins can approve/reject
      allow update: if isEventOrganizer() || (isOwner(resource.data.userId) && request.resource.data.status == 'cancelled' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']));
      allow delete: if isEventOrganizer();
    }
    
    // Attendance Logs
    match /attendance_logs/{logId} {
      allow read: if isOwner(resource.data.userId) || isEventOrganizer();
      // Only trusted backend (Cloud Functions) or Admins can create attendance logs
      allow create: if isEventOrganizer();
      allow update, delete: if isSuperAdmin();
    }
    
    // Point Transactions (Immutable Ledger)
    match /point_transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isEventOrganizer();
      allow create, update, delete: if false; // Only written by Cloud Functions
    }
    
    // Certificates
    match /certificates/{certificateId} {
      allow read: if isOwner(resource.data.userId) || isEventOrganizer();
      allow create, update, delete: if isEventOrganizer(); // Managed by admins/functions
    }
    
    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false; // Only written by Cloud Functions/Admin SDK
    }
  }
}
