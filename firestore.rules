rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() { return request.auth != null; }
    function owner(uid) { return authenticated() && request.auth.uid == uid; }
    function user() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return authenticated() && user().get('isRestricted', false) == false; }
    function superAdmin() { return active() && user().role == 'super_admin'; }
    function organizer() { return active() && user().role in ['event_organizer', 'super_admin']; }
    function text(value, max) { return value is string && value.size() <= max; }
    function optionalText(data, key, max) {
      return !(key in data) || data[key] == null || text(data[key], max);
    }
    function optionalUrl(data, key) {
      return !(key in data) || data[key] == null || data[key] == ''
        || (text(data[key], 2000) && data[key].matches('https://.*'));
    }
    function eventValid(data) {
      return data.capacity is int && data.capacity >= 0
        && data.points is int && data.points >= 0 && data.points <= 100000
        && data.registrationMode in ['Auto', 'Manual']
        && data.state in ['Draft', 'Published', 'Registration Open', 'Registration Closed', 'Ongoing', 'Completed', 'Archived'];
    }
    function profileValid(data) {
      return optionalText(data, 'displayName', 100)
        && optionalText(data, 'arabicFullName', 150)
        && optionalText(data, 'firstName', 100)
        && optionalText(data, 'fatherName', 100)
        && optionalText(data, 'familyName', 100)
        && optionalText(data, 'universityId', 20)
        && optionalText(data, 'college', 150)
        && optionalText(data, 'major', 150)
        && optionalText(data, 'academicLevel', 100)
        && optionalText(data, 'photoURL', 2000)
        && (!('profileCompleted' in data) || data.profileCompleted is bool)
        && (!('isQassimStudent' in data) || data.isQassimStudent is bool)
        && (!('publicProfile' in data) || (data.publicProfile is map
          && data.publicProfile.keys().hasOnly(['avatar', 'linkedin', 'bio'])
          && optionalText(data.publicProfile, 'avatar', 2000)
          && optionalText(data.publicProfile, 'linkedin', 500)
          && optionalUrl(data.publicProfile, 'avatar')
          && optionalUrl(data.publicProfile, 'linkedin')
          && optionalText(data.publicProfile, 'bio', 2000)))
        && (!('cardPreferences' in data) || (data.cardPreferences is map
          && data.cardPreferences.keys().hasOnly(['theme', 'pattern'])
          && optionalText(data.cardPreferences, 'theme', 40)
          && optionalText(data.cardPreferences, 'pattern', 40)));
    }

    // A user document is private. Safe public fields are projected by the backend.
    match /users/{uid} {
      allow get: if owner(uid) || organizer();
      allow list: if organizer();
      allow create: if owner(uid)
        && request.resource.data.role == 'student'
        && request.resource.data.totalPoints == 0
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.profileCompleted == false
        && request.resource.data.keys().hasOnly(['role', 'totalPoints', 'email', 'displayName', 'photoURL', 'createdAt', 'profileCompleted'])
        && profileValid(request.resource.data);
      allow update: if superAdmin() || (owner(uid) && active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'firstName', 'fatherName', 'familyName', 'arabicFullName',
          'universityId', 'college', 'major', 'academicLevel', 'isQassimStudent',
          'profileCompleted', 'profileCompletedAt', 'publicProfile', 'cardPreferences'
        ]) && profileValid(request.resource.data));
      allow delete: if superAdmin();
      match /private/{id} { allow read, write: if owner(uid) || organizer(); }
    }
    match /public_profiles/{uid} {
      allow read: if true;
      allow write: if false;
    }
    match /events/{eventId} {
      allow read: if resource.data.state in ['Published', 'Registration Open', 'Registration Closed', 'Ongoing', 'Completed', 'Archived'] || organizer();
      allow create: if organizer()
        && eventValid(request.resource.data)
        && request.resource.data.get('registeredCount', 0) == 0
        && request.resource.data.get('attendanceCount', 0) == 0;
      allow update: if organizer() && eventValid(request.resource.data)
        && (request.resource.data.get('isUnlimitedCapacity', false) == true || request.resource.data.capacity >= resource.data.get('registeredCount', 0))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['registeredCount', 'attendanceCount', 'checkinToken']);
      allow delete: if superAdmin();
    }
    match /event_secrets/{eventId} {
      allow read: if organizer();
      allow write: if false;
    }
    match /registrations/{registrationId} {
      allow get: if organizer() || (authenticated() && registrationId.matches('^.+_' + request.auth.uid + '$'));
      allow list: if organizer() || (authenticated() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /attendance_logs/{id} {
      allow read: if organizer() || owner(resource.data.userId);
      allow write: if false;
    }
    match /point_transactions/{id} {
      allow read: if organizer() || owner(resource.data.userId);
      allow write: if false;
    }
    match /pending_checkins/{id} {
      allow read: if organizer() || owner(resource.data.userId);
      allow write: if false;
    }
    match /certificates/{id} {
      allow read: if organizer() || owner(resource.data.userId);
      allow write: if false;
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if superAdmin() || (organizer() && id == 'homepage');
    }
    match /ideas/{id} {
      allow create: if active() && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'type', 'title', 'description', 'createdAt', 'status', 'isPublic', 'votesCount', 'voters'])
        && text(request.resource.data.title, 200) && text(request.resource.data.description, 3000)
        && request.resource.data.get('isPublic', false) == false
        && request.resource.data.get('votesCount', 0) == 0
        && request.resource.data.get('voters', []).size() == 0;
      allow read: if organizer() || owner(resource.data.userId) || resource.data.isPublic == true;
      allow update: if organizer() || (active() && resource.data.isPublic == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votesCount', 'voters'])
        && request.resource.data.votesCount >= 0
        && ((!(request.auth.uid in resource.data.get('voters', []))
          && request.resource.data.voters == resource.data.get('voters', []).concat([request.auth.uid])
          && request.resource.data.votesCount == resource.data.get('votesCount', 0) + 1)
          || ((request.auth.uid in resource.data.get('voters', []))
          && request.resource.data.voters == resource.data.get('voters', []).removeAll([request.auth.uid])
          && request.resource.data.votesCount == resource.data.get('votesCount', 0) - 1)));
      allow delete: if organizer();
    }
    match /event_feedback/{id} {
      allow read: if organizer() || owner(resource.data.userId);
      allow write: if false;
    }
    match /mail/{id} { allow read, write: if false; }
    match /audit_logs/{id} {
      allow read: if superAdmin();
      allow write: if false;
    }
  }
}
