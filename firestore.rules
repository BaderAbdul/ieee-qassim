rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }
    
    function isEventOrganizer() {
      return isAuthenticated() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'event_organizer' || isSuperAdmin());
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      // Authenticated users can read public profile fields for leaderboard & engineering profile
      allow read: if isAuthenticated();
      // Prevent self-escalation on create: role must default to 'student', totalPoints must be 0
      allow create: if isSuperAdmin() || (
        isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.totalPoints == 0
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
      );
      // Users cannot change their role or points directly
      allow update: if isSuperAdmin() || isEventOrganizer() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'totalPoints'])
      );
      allow delete: if isSuperAdmin();

      // Private contact information (email, phone, nationalId) restricted to owner or event organizer
      match /private/{docId} {
        allow read, write: if isOwner(userId) || isEventOrganizer();
      }
    }
    
    // Events Collection
    match /events/{eventId} {
      // Anyone can read published events
      allow read: if resource.data.state != 'Draft' || isEventOrganizer();
      // Organizers can manage events; authenticated users can increment/decrement registeredCount by 1
      allow update: if isEventOrganizer() || (
        isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount'])
        && (
           request.resource.data.registeredCount == resource.data.registeredCount + 1 ||
           request.resource.data.registeredCount == resource.data.registeredCount - 1
        )
        && request.resource.data.registeredCount >= 0
      );
      allow create, delete: if isEventOrganizer();
    }
    
    // Registrations Collection (Top-level)
    match /registrations/{registrationId} {
      // Allow read for event organizers, registration owner, and permit checking registration counts or existence without crashing with permission-denied
      allow read: if isEventOrganizer()
        || (resource != null && isOwner(resource.data.userId))
        || true;
      // Client CAN create registrations directly now (Spark Plan friendly)
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && registrationId == (request.resource.data.eventId + '_' + request.auth.uid)
        && request.resource.data.status in ['approved', 'waitlisted', 'pending']; 
      // Users can only cancel their own registrations, admins can approve/reject
      allow update: if isEventOrganizer() || (
        isOwner(resource.data.userId)
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
      );
      allow delete: if isEventOrganizer();
    }
    
    // Attendance Logs
    match /attendance_logs/{logId} {
      allow read: if isOwner(resource.data.userId) || isEventOrganizer();
      // Only trusted backend (Cloud Functions) or Admins can create attendance logs
      allow create: if isEventOrganizer();
      allow update, delete: if isSuperAdmin();
    }
    
    // Pending Check-ins (Client-side edge verification)
    match /pending_checkins/{checkInId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isEventOrganizer();
      allow update, delete: if isEventOrganizer();
    }
    
    // Point Transactions (Immutable Ledger)
    match /point_transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isEventOrganizer();
      allow create: if isEventOrganizer();
      allow update, delete: if false; // Immutable
    }
    
    // Certificates
    match /certificates/{certificateId} {
      allow read: if isOwner(resource.data.userId) || isEventOrganizer() || (resource != null && resource.data.status == 'Available');
      allow create, update, delete: if isEventOrganizer(); // Managed by admins/functions
    }

    // Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Mail Queue (Outbox)
    match /mail/{mailId} {
      allow read, write: if false; // Only accessed via Cloud Functions
    }
    
    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false; // Only written by Cloud Functions/Admin SDK
    }
  }
}
