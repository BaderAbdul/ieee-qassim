{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node",
    "outDir": ".spark-test", "rootDir": "src", "esModuleInterop": true,
    "strict": true, "skipLibCheck": true, "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"], "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/lib/server/**/*.ts", "src/app/api/**/*.ts"]
}
